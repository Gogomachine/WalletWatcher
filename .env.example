# ====================================
# Telegram Bot Configuration
# ====================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ====================================
# Database Configuration
# ====================================

# For legacy mode (SQLite)
DATABASE_PATH=./data/bot.db

# For optimized mode (PostgreSQL)
POSTGRES_URL=postgresql://wallet_watcher:your_strong_password@localhost:5432/wallet_watcher_db
POSTGRES_PASSWORD=your_strong_password

# ====================================
# Redis Configuration
# ====================================

# Redis for caching (database 0)
REDIS_URL=redis://localhost:6379/0

# Redis for FSM storage (database 1)
REDIS_FSM_URL=redis://localhost:6379/1

# ====================================
# Blockchain RPC URLs
# ====================================

# Solana RPC (default: public endpoint)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Helius API key for enhanced features
# Get one at: https://www.helius.dev/
HELIUS_API_KEY=your_helius_api_key_here

# Ethereum RPC
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# BSC RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# ====================================
# Monitoring Configuration
# ====================================

# Monitor interval in seconds (default: 10)
MONITOR_INTERVAL=10

# ====================================
# Optional: Database Management Tools
# ====================================

# pgAdmin credentials (for web interface at http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ====================================
# Performance Tuning (Advanced)
# ====================================

# PostgreSQL connection pool size (default: 20)
POSTGRES_POOL_SIZE=20

# Redis max memory (default: 256mb)
REDIS_MAX_MEMORY=256mb

# Screenshot cleanup interval in seconds (default: 3600 = 1 hour)
SCREENSHOT_CLEANUP_INTERVAL=3600
