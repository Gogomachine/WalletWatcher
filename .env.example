# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Solana RPC URL (use Helius for enhanced features)
# Get free API key at https://helius.dev
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Helius API Key (optional, for whale tracking features)
HELIUS_API_KEY=your_helius_api_key

# EVM Networks RPC URLs
# Ethereum (you can use free public RPC or get API key from Infura/Alchemy)
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# Database path
DATABASE_PATH=./data/bot.db

# Monitoring interval in seconds
MONITOR_INTERVAL=10

# Whale alert settings
WHALE_MIN_BALANCE=10000
WHALE_ALERT_CHANNEL_ID=
