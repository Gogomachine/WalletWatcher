# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram API credentials (get from https://my.telegram.org)
# Required for reading whale tracking channel
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Solana RPC URL (use Helius for enhanced features)
# Get free API key at https://helius.dev
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Helius API Key (optional, for whale tracking features)
HELIUS_API_KEY=your_helius_api_key

# Database path
DATABASE_PATH=./data/bot.db

# Monitoring interval in seconds
MONITOR_INTERVAL=10

# Whale alert settings
WHALE_MIN_BALANCE=10000
WHALE_ALERT_CHANNEL_ID=
